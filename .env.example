# BillBuddy Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ─── Stellar Network ───────────────────────────────────────────────────────────
# Options: testnet | mainnet
VITE_STELLAR_NETWORK=testnet

# Stellar Horizon RPC endpoint
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet)
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Contracts ─────────────────────────────────────────────────────────────────
# BillBuddy Soroban contract ID (deployed to testnet)
VITE_SOROBAN_CONTRACT_ID=

# SAC (Stellar Asset Contract) for the settlement asset
# Use a wrapped Stellar Classic asset, e.g., USDC or native XLM SAC
VITE_ASSET_CONTRACT_ID=

# Settlement asset code (e.g., XLM or USDC)
VITE_ASSET_CODE=XLM

# Settlement asset issuer (leave empty for native XLM)
VITE_ASSET_ISSUER=

# ─── Explorer ──────────────────────────────────────────────────────────────────
VITE_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# ─── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "false" (default) to use the real Soroban contract on Stellar Testnet.
# Set to "true" ONLY for local UI development WITHOUT a deployed contract.
# Mock mode is never the source of truth for a real deployment.
VITE_MOCK_MODE=false

# Mock mode reads/writes the shared mock-state server; the Vite dev proxy
# forwards /api here (default http://127.0.0.1:8787). Start it with:
#   node mock-server.mjs
MOCK_SERVER_URL=http://127.0.0.1:8787

# ─── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=BillBuddy
VITE_APP_VERSION=1.0.0
