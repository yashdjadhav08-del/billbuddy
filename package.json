{
  "name": "billbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "BillBuddy - Smart Household Bill Tracker & Settlement",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:srv": "node mock-server.mjs",
    "test:srv": "node --test mock-server.test.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test:srv && npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web"
  }
}
